# {{ ansible_managed }}
[Unit]
Description=tts-serve engine: {{ tts_engine_name }}
After=network.target

[Service]
Type=simple
User={{ tts_engine_service_user }}
WorkingDirectory={{ tts_engine_serve_dir }}
{% for key, value in tts_engine_launch_env.items() %}
Environment={{ key }}={{ value }}
{% endfor %}
ExecStart={{ tts_engine_launch_cmd }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
